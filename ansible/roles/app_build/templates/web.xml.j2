<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ ansible_managed }} -->
<!-- Database mode: {{ db_mode }} -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Customer Onboarding</display-name>

    <context-param>
        <param-name>dbUrl</param-name>
{% if db_mode == 'oracle' %}
        <param-value>jdbc:oracle:thin:@//{{ oracle_db_host }}:{{ oracle_listener_port }}/{{ oracle_pdb }}</param-value>
{% else %}
        <param-value>{{ h2_jdbc_url }}</param-value>
{% endif %}
    </context-param>
    <context-param>
        <param-name>dbUser</param-name>
{% if db_mode == 'oracle' %}
        <param-value>{{ oracle_app_user }}</param-value>
{% else %}
        <param-value>{{ h2_user }}</param-value>
{% endif %}
    </context-param>
    <context-param>
        <param-name>dbPassword</param-name>
{% if db_mode == 'oracle' %}
        <param-value>{{ oracle_app_password }}</param-value>
{% else %}
        <param-value>{{ h2_password }}</param-value>
{% endif %}
    </context-param>
    <context-param>
        <param-name>appUsername</param-name>
        <param-value>{{ app_login_username }}</param-value>
    </context-param>
    <context-param>
        <param-name>appPassword</param-name>
        <param-value>{{ app_login_password }}</param-value>
    </context-param>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
