# Managed by Ansible (kube_metrics role) — local edits are overwritten.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ kube_metrics_namespace }}
---
# --------------------------------------------------------------------------
# node-exporter: host metrics for the k8s nodes.
#
# A DaemonSet rather than the systemd unit the other VMs get, so the cluster
# schedules and restarts it, and a node added later is covered automatically.
# --------------------------------------------------------------------------
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-exporter
  namespace: {{ kube_metrics_namespace }}
  labels: {app: node-exporter}
spec:
  selector:
    matchLabels: {app: node-exporter}
  template:
    metadata:
      labels: {app: node-exporter}
    spec:
      # Host metrics are meaningless from inside a container's namespaces:
      # without these the exporter reports the POD's network and processes.
      hostNetwork: true
      hostPID: true
      # The control-plane taint was removed on this cluster so WebLogic can run
      # there, but tolerate it anyway -- a rebuilt cluster may put it back, and
      # a monitoring gap on the busiest node is the worst place to have one.
      tolerations:
        - operator: Exists
      containers:
        - name: node-exporter
          image: {{ kube_node_exporter_image }}
          args:
            - --path.procfs=/host/proc
            - --path.sysfs=/host/sys
            - --path.rootfs=/host/root
            - --web.listen-address=:{{ kube_node_exporter_port }}
          ports:
            - containerPort: {{ kube_node_exporter_port }}
              hostPort: {{ kube_node_exporter_port }}
              name: metrics
          resources:
            requests: {memory: 32Mi, cpu: 20m}
            limits: {memory: 128Mi}
          volumeMounts:
            - {name: proc, mountPath: /host/proc, readOnly: true}
            - {name: sys, mountPath: /host/sys, readOnly: true}
            - {name: root, mountPath: /host/root, readOnly: true, mountPropagation: HostToContainer}
      volumes:
        - {name: proc, hostPath: {path: /proc}}
        - {name: sys, hostPath: {path: /sys}}
        - {name: root, hostPath: {path: /}}
---
# --------------------------------------------------------------------------
# kube-state-metrics: the state of Kubernetes OBJECTS (deployments, pods,
# restarts, phases). Distinct from node-exporter, which reports the machines,
# and from cAdvisor, which reports container resource usage.
# --------------------------------------------------------------------------
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kube-state-metrics
  namespace: {{ kube_metrics_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kube-state-metrics
rules:
  - apiGroups: [""]
    resources: [nodes, pods, services, resourcequotas, replicationcontrollers, limitranges, persistentvolumeclaims, persistentvolumes, namespaces, endpoints]
    verbs: [list, watch]
  - apiGroups: [apps]
    resources: [statefulsets, daemonsets, deployments, replicasets]
    verbs: [list, watch]
  - apiGroups: [batch]
    resources: [cronjobs, jobs]
    verbs: [list, watch]
  - apiGroups: [autoscaling]
    resources: [horizontalpodautoscalers]
    verbs: [list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kube-state-metrics
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: kube-state-metrics}
subjects:
  - {kind: ServiceAccount, name: kube-state-metrics, namespace: {{ kube_metrics_namespace }}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kube-state-metrics
  namespace: {{ kube_metrics_namespace }}
  labels: {app: kube-state-metrics}
spec:
  replicas: 1
  selector:
    matchLabels: {app: kube-state-metrics}
  template:
    metadata:
      labels: {app: kube-state-metrics}
    spec:
      serviceAccountName: kube-state-metrics
      containers:
        - name: kube-state-metrics
          image: {{ kube_state_metrics_image }}
          ports:
            - {containerPort: 8080, name: metrics}
          resources:
            requests: {memory: 64Mi, cpu: 20m}
            limits: {memory: 192Mi}
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
---
apiVersion: v1
kind: Service
metadata:
  name: kube-state-metrics
  namespace: {{ kube_metrics_namespace }}
  labels: {app: kube-state-metrics}
spec:
  type: NodePort
  selector: {app: kube-state-metrics}
  ports:
    - {name: metrics, port: 8080, targetPort: 8080, nodePort: {{ kube_state_metrics_nodeport }}}
---
# --------------------------------------------------------------------------
# Credentials for Prometheus, which runs OUTSIDE this cluster and therefore
# cannot use in-pod service account projection. Read-only: it may read node
# and metrics endpoints and nothing else.
# --------------------------------------------------------------------------
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prometheus-scraper
  namespace: {{ kube_metrics_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: prometheus-scraper
rules:
  - apiGroups: [""]
    resources: [nodes, nodes/metrics, nodes/stats, nodes/proxy, services, endpoints, pods]
    verbs: [get, list, watch]
  - nonResourceURLs: [/metrics, /metrics/cadvisor]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: prometheus-scraper
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: prometheus-scraper}
subjects:
  - {kind: ServiceAccount, name: prometheus-scraper, namespace: {{ kube_metrics_namespace }}}
---
# Kubernetes 1.24+ stopped auto-creating service account token secrets, and
# 1.31 is what this cluster runs. An external scraper needs a token that does
# not expire, so it must be requested explicitly like this.
apiVersion: v1
kind: Secret
metadata:
  name: prometheus-scraper-token
  namespace: {{ kube_metrics_namespace }}
  annotations:
    kubernetes.io/service-account.name: prometheus-scraper
type: kubernetes.io/service-account-token
