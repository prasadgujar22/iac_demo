-- {{ ansible_managed }}
-- Idempotent application schema bootstrap.
SET SERVEROUTPUT ON
WHENEVER SQLERROR EXIT SQL.SQLCODE

DECLARE
  v_count NUMBER;
BEGIN
  SELECT COUNT(*) INTO v_count FROM dba_users WHERE username = UPPER('{{ oracle_app_user }}');
  IF v_count = 0 THEN
    EXECUTE IMMEDIATE 'CREATE USER {{ oracle_app_user }} IDENTIFIED BY "{{ oracle_app_password }}"';
    DBMS_OUTPUT.PUT_LINE('user created');
  ELSE
    EXECUTE IMMEDIATE 'ALTER USER {{ oracle_app_user }} IDENTIFIED BY "{{ oracle_app_password }}"';
    DBMS_OUTPUT.PUT_LINE('user exists - password reset');
  END IF;
END;
/

GRANT CONNECT, RESOURCE TO {{ oracle_app_user }};
ALTER USER {{ oracle_app_user }} QUOTA UNLIMITED ON USERS;

-- The application also creates this table on first access; creating it here
-- means the very first request does not pay the DDL cost.
DECLARE
BEGIN
  EXECUTE IMMEDIATE 'CREATE TABLE {{ oracle_app_user }}.CUSTOMER_ONBOARDING (
    ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    CUSTOMER_NAME VARCHAR2(150) NOT NULL,
    COMPANY_NAME VARCHAR2(150) NOT NULL,
    EMAIL VARCHAR2(150) NOT NULL,
    PHONE_NUMBER VARCHAR2(30),
    ADDRESS_LINE1 VARCHAR2(200),
    ADDRESS_LINE2 VARCHAR2(200),
    CITY VARCHAR2(80),
    STATE VARCHAR2(80),
    POSTAL_CODE VARCHAR2(20),
    COUNTRY VARCHAR2(80),
    ONBOARDING_STATUS VARCHAR2(40) NOT NULL,
    NOTES VARCHAR2(500),
    CREATED_DATE DATE DEFAULT SYSDATE NOT NULL)';
  DBMS_OUTPUT.PUT_LINE('table created');
EXCEPTION
  WHEN OTHERS THEN
    IF SQLCODE != -955 THEN RAISE; END IF;   -- -955 = already exists
    DBMS_OUTPUT.PUT_LINE('table exists');
END;
/
EXIT
