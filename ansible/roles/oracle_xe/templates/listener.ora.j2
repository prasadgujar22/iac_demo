# {{ ansible_managed }}
#
# Bind to the VM's actual address rather than the hostname.
# The installer-generated file uses HOST=<hostname>, which resolves only inside
# the VM, so remote clients (WebLogic pods) get:
#   ORA-12541: Cannot connect. No listener
#
DEFAULT_SERVICE_LISTENER = XE

LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ ansible_host | default(ansible_default_ipv4.address) }})(PORT = {{ oracle_listener_port }}))
      (ADDRESS = (PROTOCOL = IPC)(KEY = EXTPROC{{ oracle_listener_port }}))
    )
  )
