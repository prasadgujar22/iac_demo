        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "count(kube_deployment_status_replicas_available < kube_deployment_spec_replicas)",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
