          "expr": "(1 - node_filesystem_avail_bytes{tier=\"database\",mountpoint=\"/\"} / node_filesystem_size_bytes{tier=\"database\",mountpoint=\"/\"}) * 100",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "root %"
