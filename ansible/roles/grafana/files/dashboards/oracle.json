        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\",tier=\"database\"}[5m])) * 100",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "cpu %"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "(1 - node_memory_MemAvailable_bytes{tier=\"database\"} / node_memory_MemTotal_bytes{tier=\"database\"}) * 100",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "memory %"
