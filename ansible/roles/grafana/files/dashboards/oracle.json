    {
      "type": "timeseries",
      "title": "DB VM CPU and memory",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
