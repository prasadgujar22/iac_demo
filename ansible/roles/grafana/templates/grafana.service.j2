# Managed by Ansible (grafana role) — local edits are overwritten.
[Unit]
Description=Grafana
After=docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f grafana
ExecStart=/usr/bin/docker run --rm --name grafana \
  --user {{ grafana_uid }} \
  -p {{ grafana_port }}:{{ grafana_port }} \
  -e GF_SECURITY_ADMIN_USER={{ grafana_admin_user }} \
  -e GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }} \
  -e GF_USERS_ALLOW_SIGN_UP=false \
  -e GF_SERVER_HTTP_PORT={{ grafana_port }} \
  -e GF_ANALYTICS_REPORTING_ENABLED=false \
  -e GF_ANALYTICS_CHECK_FOR_UPDATES=false \
  -v {{ grafana_config_dir }}/provisioning:/etc/grafana/provisioning:ro \
  -v {{ grafana_dashboard_dir }}:/var/lib/grafana/dashboards:ro \
  -v {{ grafana_data_dir }}:/var/lib/grafana \
  {{ grafana_image }}
ExecStop=/usr/bin/docker stop grafana

[Install]
WantedBy=multi-user.target
