# Managed by Ansible (nginx_metrics role) — local edits are overwritten.
listen:
  port: {{ nginxlog_exporter_port }}
  address: "0.0.0.0"
  metrics_endpoint: /metrics

namespaces:
  - name: nginx
    # Must match the log_format in wls-proxy.conf EXACTLY. Both come from
    # nginx_log_format in group_vars/all.yml precisely so they cannot drift:
    # a mismatch yields parse errors and no data, not an error anyone sees.
    format: {{ nginx_log_format | to_json }}
    source:
      files:
        - {{ nginxlog_access_log }}
    histogram_buckets: {{ nginxlog_buckets | to_json }}
    # No relabel_configs. The default label set is what this exporter derives
    # from the format itself; a hand-written relabel rule here was a guess at a
    # schema, and a guess that fails takes the whole exporter down rather than
    # degrading. Check the emitted labels for anything high-cardinality (a
    # per-URL label would be the thing to watch) and add rules deliberately if
    # they turn out to be needed.
