// ============================================================================
// Full infrastructure + application pipeline
//
// AGENT
// The 'homelab' label matches this Jenkins controller's own built-in node
// (see ~/.jenkins/config.xml) running directly on the host — there is no
// separate Docker or SSH agent. terraform/ansible/packer/kubectl/multipass
// run directly on the host because they drive host-level hypervisors
// (Multipass daemon); see the PATH note in the environment{} block below for
// a real failure mode this causes after a Jenkins restart.
//
// Starts every VM that exists but is stopped (Start VMs stage below), then
// creates whatever doesn't exist yet when APPLY=true (Apply infrastructure).
// ============================================================================

pipeline {
    agent { label 'homelab' }

    options {
        timestamps()
        ansiColor('xterm')                 // interpret Ansible's ANSI color codes instead of dumping raw escape bytes
        disableConcurrentBuilds()          // concurrent terraform runs corrupt state
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 90, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'BUILD_IMAGE',
            defaultValue: false,
            description: 'Rebuild the WebLogic domain image with Packer. Only needed when the domain TOPOLOGY changes (cluster name, server count, ports). Application changes do not require this.'
        )
        choice(
            name: 'DB_MODE',
            choices: ['oracle', 'h2'],
            description: 'oracle = Oracle XE on Multipass, shared by both managed servers. h2 = embedded in-memory, per-pod dataset (no cross-server visibility).'
        )
        booleanParam(
            name: 'APPLY',
            defaultValue: false,
            description: 'Unchecked = plan only (no changes). Checked = apply. Defaults to plan so an accidental build cannot mutate infrastructure.'
        )
        booleanParam(
            name: 'DEPLOY_APP',
            defaultValue: true,
            description: 'Build the WAR and deploy it after provisioning.'
        )
        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Branch of the application repository to build.'
        )
    }

    environment {
        REPO_ROOT   = "${WORKSPACE}"
        TF_IN_AUTOMATION = 'true'
        TF_INPUT    = '0'
        ANSIBLE_FORCE_COLOR = 'true'
        PY_COLORS   = '1'
        // The 'homelab' agent is just this Jenkins controller's own built-in
        // node (see ~/.jenkins/config.xml) running directly on macOS, NOT a
        // separate Docker/SSH agent as the header comment above describes.
        // Its process PATH comes from whatever launched it (a LaunchAgent
        // plist that Homebrew regenerates, stripped of any PATH override,
        // on every `brew services restart`) — so every stage's PATH must be
        // set explicitly here rather than relying on the controller's
        // ambient environment. Without this, terraform/packer/ansible/
        // kubectl/helm/multipass/mvn (all Homebrew-installed) are invisible
        // and Preflight fails outright.
        PATH = "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:${env.PATH}"
    }

    stages {

        stage('Start VMs') {
            steps {
                script {
                    // Discover each stack's VM name(s) via `terraform console`
                    // against var.* defaults rather than `terraform output` --
                    // this works even when a stack has never been applied
                    // (fresh create) or was destroyed, so the stage can't
                    // hard-fail on "Output ... not found". Folded in from the
                    // former homelab-start job.
                    sh '''#!/bin/bash
set -euo pipefail
                        for d in terraform/05-k8s-multipass terraform/10-db-multipass terraform/30-nginx-multipass; do
                            terraform -chdir="$d" init -reconfigure -no-color -input=false >/dev/null
                        done
                    '''
                    env.NGINX_VM = sh(
                        script: '''echo 'var.vm_name' | terraform -chdir=terraform/30-nginx-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.DB_VM = sh(
                        script: '''echo 'var.vm_name' | terraform -chdir=terraform/10-db-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.MASTER_VM = sh(
                        script: '''echo 'var.master_name' | terraform -chdir=terraform/05-k8s-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.WORKER_VMS = sh(
                        script: '''echo 'join(" ", var.worker_names)' | terraform -chdir=terraform/05-k8s-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    echo "nginx=${env.NGINX_VM} master=${env.MASTER_VM} workers=${env.WORKER_VMS} db=${env.DB_VM}"

                    sh '''#!/bin/bash
set -uo pipefail
                        # multipass requires client authentication (local.passphrase is
                        # set). CI runs as a user that is not authenticated, while root
                        # bypasses the check -- so fall back to sudo, same as every
                        # provisioner in this repo.
                        mp() { if multipass "$@" 2>/dev/null; then return 0; else sudo -n multipass "$@"; fi; }

                        start_if_stopped() {
                            local name="$1"
                            local state
                            state=$(mp info "$name" --format csv 2>/dev/null | awk -F, 'NR>1{print $2}')
                            if [ -z "$state" ]; then
                                echo "[start] $name: not found, skipping (Apply infrastructure will create it if APPLY=true)"
                            elif [ "$state" = "Running" ]; then
                                echo "[start] $name: already running"
                            else
                                echo "[start] starting $name"
                                mp start "$name"
                            fi
                        }

                        # Database and k8s first, nginx last -- the app has
                        # something to talk to by the time the front door opens.
                        start_if_stopped "$DB_VM"
                        start_if_stopped "$MASTER_VM"
                        for w in $WORKER_VMS; do start_if_stopped "$w"; done
                        start_if_stopped "$NGINX_VM"

                        echo "[start] current state:"
                        mp list

                        # If the control-plane VM exists and is (now) running, give the
                        # API server a little time to come back before Preflight checks
                        # it -- a node just resumed from `multipass start` is not
                        # instantly Ready, and Preflight is meant to fail fast on genuine
                        # faults, not on transient post-boot delay.
                        if [ -n "${MASTER_VM:-}" ]; then
                            state=$(mp info "$MASTER_VM" --format csv 2>/dev/null | awk -F, 'NR>1{print $2}')
                            if [ "$state" = "Running" ]; then
                                echo "[start] waiting for k8s API and node readiness..."
                                for i in $(seq 1 30); do
                                    if kubectl cluster-info >/dev/null 2>&1; then
                                        notready=$(kubectl get nodes --no-headers 2>/dev/null | awk '$2!="Ready"{c++} END{print c+0}')
                                        if [ "${notready:-1}" -eq 0 ]; then
                                            echo "[start] k8s API reachable, all nodes Ready"
                                            break
                                        fi
                                    fi
                                    sleep 10
                                done
                            fi
                        fi
                    '''
                }
            }
        }

        stage('Preflight') {
            steps {
                // Fails fast on platform faults (USB uplink carrier down, k8s node
                // NotReady, missing tools) rather than halfway through provisioning.
                sh './scripts/preflight.sh'
            }
        }

        stage('Validate') {
            // Static validation of every artifact before anything is applied.
            parallel {
                stage('terraform') {
                    steps {
                        sh '''#!/bin/bash
set -euo pipefail
                            for d in terraform/*/; do
                                echo "--- validating $d"
                                terraform -chdir="$d" init -backend=false -no-color
                                terraform -chdir="$d" validate -no-color
                            done
                        '''
                    }
                }
                stage('ansible') {
                    steps {
                        sh '''#!/bin/bash
set -euo pipefail
                            cd ansible
                            ansible-playbook playbooks/site.yml --syntax-check
                            ansible-playbook playbooks/deploy-app.yml --syntax-check
                        '''
                    }
                }
                stage('packer') {
                    steps {
                        sh '''#!/bin/bash
set -euo pipefail
                            cd packer/wls-domain-image
                            packer init .
                            packer validate .
                        '''
                    }
                }
            }
        }

        stage('Build domain image') {
            when { expression { params.BUILD_IMAGE } }
            steps {
                // Admin credentials are no longer baked into the image -- the
                // WDT model resolves them from the operator's
                // __weblogic-credentials__ K8s secret at domain-creation time
                // (see terraform/20-wls-k8s), so packer needs no credentials.
                sh '''#!/bin/bash
set -euo pipefail
                    cd packer/wls-domain-image
                    # .generated/ is gitignored (machine-specific output), so a
                    # fresh CI workspace never has it -- unlike Terraform's
                    # local_file resource, Packer's manifest post-processor
                    # does not create its own parent directory.
                    mkdir -p .generated
                    # Tag by build number so a bad image can be rolled back.
                    packer build \
                      -var "image_tag=2.${BUILD_NUMBER}" \
                      .
                '''
                script {
                    // Carries the freshly-built tag to the Plan stage below,
                    // which passes it through to 20-wls-k8s so Terraform
                    // deploys what Packer just built instead of
                    // variables.tf's stale hardcoded default. Unset when
                    // BUILD_IMAGE=false, so that stack keeps using its own
                    // default as before.
                    env.DOMAIN_IMAGE = "wls-domain-image:2.${env.BUILD_NUMBER}"
                }
                // There is no registry in this homelab -- Packer only
                // produces a local Docker image on this Jenkins host, and
                // the k8s nodes pull with imagePullPolicy: IfNotPresent
                // from their own containerd, which never hears about it
                // otherwise. Save it here; it gets distributed to the nodes
                // by the 'Load domain image onto k8s nodes' stage below,
                // AFTER 'Apply k8s tier' -- on a from-scratch bootstrap the
                // nodes don't exist yet at this point in the pipeline, so
                // `multipass exec` here would have nothing to target.
                sh '''#!/bin/bash
set -euo pipefail
                    TAG="wls-domain-image:2.${BUILD_NUMBER}"
                    TAR="packer/wls-domain-image/.generated/domain-image-2.${BUILD_NUMBER}.tar"
                    echo "[image] saving $TAG for distribution to k8s nodes"
                    docker save "$TAG" -o "$TAR"
                '''
            }
        }

        stage('Plan k8s tier') {
            steps {
                // 05-k8s-multipass is planned (and, below, applied) on its own,
                // ahead of everything else: 20-wls-k8s's kubernetes_manifest
                // resources need a live, reachable k8s API just to compute a
                // PLAN (not only to apply) -- they fetch the CRD's OpenAPI
                // schema from the cluster itself. On a from-scratch bootstrap
                // (e.g. right after a full teardown) that cluster doesn't
                // exist yet, so planning it together with the other stacks
                // before any apply has happened fails with "Invalid
                // configuration for API client ... dial tcp ... timeout".
                // Applying this stack first (when APPLY=true) makes the
                // cluster live before 20-wls-k8s is ever planned.
                sh '''#!/bin/bash
set -euo pipefail
                    terraform -chdir=terraform/05-k8s-multipass init -reconfigure -no-color -input=false
                    terraform -chdir=terraform/05-k8s-multipass plan -no-color -out=tfplan
                '''
            }
        }

        stage('Approve apply — k8s tier') {
            when { expression { params.APPLY } }
            steps {
                script {
                    timeout(time: 15, unit: 'MINUTES') {
                        input message: 'Apply the k8s tier (VMs + kubeadm cluster)? It must exist before the WebLogic-on-k8s stack can even be planned.',
                              ok: 'Apply'
                    }
                }
            }
        }

        stage('Apply k8s tier') {
            when { expression { params.APPLY } }
            // Bounded independently of the 90-minute pipeline timeout: a
            // from-scratch bootstrap here is two cold VM launches plus a
            // kubeadm init/join, and a stall used to sit undetected until
            // the whole pipeline timed out. Terraform's own provisioners are
            // watchdogged too (see mp_wait in 05-k8s-multipass/main.tf);
            // this is the outer backstop.
            options { timeout(time: 45, unit: 'MINUTES') }
            steps {
                sh 'terraform -chdir=terraform/05-k8s-multipass apply -no-color tfplan'
            }
        }

        stage('Load domain image onto k8s nodes') {
            when { expression { params.BUILD_IMAGE && params.APPLY } }
            steps {
                // Only reachable once the k8s tier above has actually been
                // applied, so MASTER_VM/WORKER_VMS (from 'Start VMs') are
                // real, existing instances -- import onto every node's
                // containerd so 20-wls-k8s's later apply doesn't
                // ErrImagePull against an image no registry has.
                sh '''#!/bin/bash
set -euo pipefail
                    mp() { if multipass "$@" 2>/dev/null; then return 0; else sudo -n multipass "$@"; fi; }
                    TAG="wls-domain-image:2.${BUILD_NUMBER}"
                    TAR="packer/wls-domain-image/.generated/domain-image-2.${BUILD_NUMBER}.tar"
                    for vm in "$MASTER_VM" $WORKER_VMS; do
                        echo "[image] loading $TAG onto $vm"
                        mp transfer "$TAR" "$vm":/tmp/domain-image.tar
                        mp exec "$vm" -- sudo ctr -n k8s.io images import /tmp/domain-image.tar
                        mp exec "$vm" -- rm -f /tmp/domain-image.tar
                    done
                    rm -f "$TAR"
                '''
            }
        }

        stage('Plan') {
            steps {
                script {
                    // 10-db is skipped entirely in h2 mode — no database to provision.
                    def stacks = params.DB_MODE == 'oracle'
                        ? ['10-db-multipass', '20-wls-k8s', '30-nginx-multipass']
                        : ['20-wls-k8s', '30-nginx-multipass']
                    stacks.each { s ->
                        if (s == '20-wls-k8s' && sh(script: 'kubectl cluster-info >/dev/null 2>&1', returnStatus: true) != 0) {
                            // Only reachable here with APPLY=false (a pure dry
                            // run/preview): the k8s tier above only PLANS in
                            // that mode, so the cluster never actually comes
                            // up. Skip this one stack's plan instead of
                            // failing the whole preview -- there's nothing
                            // meaningful to preview against a cluster that
                            // doesn't exist yet.
                            echo "[plan] skipping 20-wls-k8s: k8s API unreachable (cluster not created yet -- re-run with APPLY=true to create it, then this stack can be planned/applied)"
                            return
                        }
                        // Only 20-wls-k8s takes domain_image, and only when
                        // this run actually built one (see 'Build domain
                        // image' above) -- otherwise fall through to
                        // variables.tf's own default unchanged.
                        def varArgs = (s == '20-wls-k8s' && env.DOMAIN_IMAGE) ? "-var \"domain_image=${env.DOMAIN_IMAGE}\"" : ''
                        sh """#!/bin/bash
set -euo pipefail
                            # -reconfigure: the workspace may hold a stale local state file from a
                            # previous run, and terraform then asks interactively whether to migrate
                            # it to the configured backend. With -input=false that becomes the
                            # opaque "Error: input is disabled". The shared backend is the source of
                            # truth, so discard any workspace-local backend config.
                            terraform -chdir=terraform/${s} init -reconfigure -no-color -input=false
                            terraform -chdir=terraform/${s} plan -no-color -out=tfplan ${varArgs}
                        """
                    }
                }
            }
        }

        stage('Approve apply') {
            when { expression { params.APPLY } }
            steps {
                script {
                    // Guard rail: provisioning touches shared host networking.
                    timeout(time: 15, unit: 'MINUTES') {
                        input message: "Apply infrastructure changes? (DB_MODE=${params.DB_MODE})",
                              ok: 'Apply'
                    }
                }
            }
        }

        stage('Apply infrastructure') {
            when { expression { params.APPLY } }
            steps {
                script {
                    def stacks = params.DB_MODE == 'oracle'
                        ? ['10-db-multipass', '20-wls-k8s', '30-nginx-multipass']
                        : ['20-wls-k8s', '30-nginx-multipass']
                    stacks.each { s ->
                        sh "terraform -chdir=terraform/${s} apply -no-color tfplan"
                    }
                }
            }
        }

        stage('Configure') {
            when { expression { params.APPLY } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'oracle-sys',
                                     usernameVariable: 'ORA_SYS_USER',
                                     passwordVariable: 'ORA_SYS_PASS'),
                    usernamePassword(credentialsId: 'oracle-app',
                                     usernameVariable: 'ORA_APP_USER',
                                     passwordVariable: 'ORA_APP_PASS')
                ]) {
                    // Secrets arrive as env vars and are passed via -e without ever
                    // being written to disk or echoed.
                    script {
                        // Skip the app tag when DEPLOY_APP is false; there is no
                        // shell-side conditional in --skip-tags.
                        def skip = params.DEPLOY_APP ? '' : '--skip-tags app'
                        sh """#!/bin/bash
set -euo pipefail
                            cd ansible
                            ansible-playbook playbooks/site.yml \
                              -e "db_mode=\${DB_MODE}" \
                              -e "app_repo_version=\${APP_BRANCH}" \
                              -e "oracle_sys_password=\${ORA_SYS_PASS}" \
                              -e "oracle_app_user=\${ORA_APP_USER}" \
                              -e "oracle_app_password=\${ORA_APP_PASS}" \
                              ${skip}
                        """
                    }
                }
            }
        }

        stage('Deploy application') {
            when {
                allOf {
                    expression { params.DEPLOY_APP }
                    expression { !params.APPLY }   // Configure already deployed it
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'oracle-app',
                    usernameVariable: 'ORA_APP_USER',
                    passwordVariable: 'ORA_APP_PASS')]) {
                    sh '''#!/bin/bash
set -euo pipefail
                        cd ansible
                        ansible-playbook playbooks/deploy-app.yml \
                          -e "db_mode=${DB_MODE}" \
                          -e "app_repo_version=${APP_BRANCH}" \
                          -e "oracle_app_user=${ORA_APP_USER}" \
                          -e "oracle_app_password=${ORA_APP_PASS}"
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                // Real HTTP assertions: session affinity across the login handover,
                // distribution across servers, and a write-then-read round trip.
                sh '''#!/bin/bash
set -euo pipefail
                    cd ansible
                    ansible-playbook playbooks/site.yml --tags verify -e "db_mode=${DB_MODE}"
                '''
            }
        }
    }

    post {
        success {
            script {
                // This host has no physical LAN (the 192.168.29.x addresses below
                // are the original Linux homelab box's); resolve the real Multipass
                // IPs from Terraform state the same way the "Resolve environment
                // networking overrides" play in ansible/playbooks/site.yml does,
                // falling back to the upstream LAN addresses when that stack's
                // state isn't reachable (e.g. running against the real Linux host).
                def proxyIp = sh(
                    script: '''#!/bin/bash
set -uo pipefail
terraform -chdir=terraform/30-nginx-multipass init -reconfigure -no-color -input=false >/dev/null 2>&1
terraform -chdir=terraform/30-nginx-multipass output -raw proxy_internal_ip 2>/dev/null
''',
                    returnStdout: true
                ).trim()
                if (!proxyIp) { proxyIp = '192.168.29.200' }

                def nodeIp = sh(
                    script: '''#!/bin/bash
set -uo pipefail
terraform -chdir=terraform/05-k8s-multipass init -reconfigure -no-color -input=false >/dev/null 2>&1
terraform -chdir=terraform/05-k8s-multipass output -raw master_ip 2>/dev/null
''',
                    returnStdout: true
                ).trim()
                def ms1Endpoint = nodeIp ? "http://${nodeIp}:30701/customer-onboarding/login" : 'http://192.168.29.201:8090/customer-onboarding/login'
                def ms2Endpoint = nodeIp ? "http://${nodeIp}:30702/customer-onboarding/login" : 'http://192.168.29.202:8090/customer-onboarding/login'

                echo """
================================================================
  Pipeline succeeded

  APPLICATION URL:
    http://${proxyIp}/customer-onboarding/login

  Direct per-JVM endpoints:
    ms1  ${ms1Endpoint}
    ms2  ${ms2Endpoint}

  Database mode: ${params.DB_MODE}
================================================================
"""
            }
        }
        failure {
            echo 'Pipeline failed. Check the Preflight stage first — most failures are platform faults (USB uplink carrier down, k8s node NotReady) rather than code errors.'
        }
        always {
            archiveArtifacts artifacts: 'terraform/*/.generated/*, packer/*/.generated/*',
                             allowEmptyArchive: true,
                             fingerprint: true
        }
    }
}
