// ============================================================================
// Full infrastructure + application pipeline
//
// AGENT REQUIREMENT
// Jenkins runs in a Docker container here (jenkins/jenkins:lts-jdk17) which
// contains ONLY git and ssh — no terraform, ansible, packer, kubectl, lxc or
// multipass. Those tools must run on the HOST because they drive host-level
// hypervisors (LXD unix socket, Multipass daemon, libvirt). Installing them in
// the container would not help.
//
// Therefore this pipeline requires an SSH agent labelled 'homelab' that points
// back at the host. Run jenkins/bootstrap-agent.sh once to create it.
// ============================================================================

pipeline {
    agent { label 'homelab' }

    options {
        timestamps()
        ansiColor('xterm')                 // interpret Ansible's ANSI color codes instead of dumping raw escape bytes
        disableConcurrentBuilds()          // concurrent terraform runs corrupt state
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 90, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'BUILD_IMAGE',
            defaultValue: false,
            description: 'Rebuild the WebLogic domain image with Packer. Only needed when the domain TOPOLOGY changes (cluster name, server count, ports). Application changes do not require this.'
        )
        choice(
            name: 'DB_MODE',
            choices: ['oracle', 'h2'],
            description: 'oracle = Oracle XE on Multipass, shared by both managed servers. h2 = embedded in-memory, per-pod dataset (no cross-server visibility).'
        )
        booleanParam(
            name: 'APPLY',
            defaultValue: false,
            description: 'Unchecked = plan only (no changes). Checked = apply. Defaults to plan so an accidental build cannot mutate infrastructure.'
        )
        booleanParam(
            name: 'DEPLOY_APP',
            defaultValue: true,
            description: 'Build the WAR and deploy it after provisioning.'
        )
        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Branch of the application repository to build.'
        )
    }

    environment {
        REPO_ROOT   = "${WORKSPACE}"
        TF_IN_AUTOMATION = 'true'
        TF_INPUT    = '0'
        ANSIBLE_FORCE_COLOR = 'true'
        PY_COLORS   = '1'
        // The 'homelab' agent is just this Jenkins controller's own built-in
        // node (see ~/.jenkins/config.xml) running directly on macOS, NOT a
        // separate Docker/SSH agent as the header comment above describes.
        // Its process PATH comes from whatever launched it (a LaunchAgent
        // plist that Homebrew regenerates, stripped of any PATH override,
        // on every `brew services restart`) — so every stage's PATH must be
        // set explicitly here rather than relying on the controller's
        // ambient environment. Without this, terraform/packer/ansible/
        // kubectl/helm/multipass/mvn (all Homebrew-installed) are invisible
        // and Preflight fails outright.
        PATH = "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:${env.PATH}"
    }

    stages {

        stage('Preflight') {
            steps {
                // Fails fast on platform faults (USB uplink carrier down, k8s node
                // NotReady, missing tools) rather than halfway through provisioning.
                sh './scripts/preflight.sh'
            }
        }

        stage('Validate') {
            // Static validation of every artifact before anything is applied.
            parallel {
                stage('terraform') {
                    steps {
                        sh '''#!/bin/bash
set -euo pipefail
                            for d in terraform/*/; do
                                echo "--- validating $d"
                                terraform -chdir="$d" init -backend=false -no-color
                                terraform -chdir="$d" validate -no-color
                            done
                        '''
                    }
                }
                stage('ansible') {
                    steps {
                        sh '''#!/bin/bash
set -euo pipefail
                            cd ansible
                            ansible-playbook playbooks/site.yml --syntax-check
                            ansible-playbook playbooks/deploy-app.yml --syntax-check
                        '''
                    }
                }
                stage('packer') {
                    steps {
                        sh '''#!/bin/bash
set -euo pipefail
                            cd packer/wls-domain-image
                            packer init .
                            packer validate .
                        '''
                    }
                }
            }
        }

        stage('Build domain image') {
            when { expression { params.BUILD_IMAGE } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'wls-admin',
                    usernameVariable: 'WLS_USER',
                    passwordVariable: 'WLS_PASS')]) {
                    sh '''#!/bin/bash
set -euo pipefail
                        cd packer/wls-domain-image
                        # Tag by build number so a bad image can be rolled back.
                        packer build \
                          -var "image_tag=2.${BUILD_NUMBER}" \
                          -var "admin_username=${WLS_USER}" \
                          .
                    '''
                }
            }
        }

        stage('Plan') {
            steps {
                script {
                    // 10-db is skipped entirely in h2 mode — no database to provision.
                    def stacks = params.DB_MODE == 'oracle'
                        ? ['10-db-multipass', '20-wls-k8s', '30-nginx-multipass']
                        : ['20-wls-k8s', '30-nginx-multipass']
                    stacks.each { s ->
                        sh """#!/bin/bash
set -euo pipefail
                            # -reconfigure: the workspace may hold a stale local state file from a
                            # previous run, and terraform then asks interactively whether to migrate
                            # it to the configured backend. With -input=false that becomes the
                            # opaque "Error: input is disabled". The shared backend is the source of
                            # truth, so discard any workspace-local backend config.
                            terraform -chdir=terraform/${s} init -reconfigure -no-color -input=false
                            terraform -chdir=terraform/${s} plan -no-color -out=tfplan
                        """
                    }
                }
            }
        }

        stage('Approve apply') {
            when { expression { params.APPLY } }
            steps {
                script {
                    // Guard rail: provisioning touches shared host networking.
                    timeout(time: 15, unit: 'MINUTES') {
                        input message: "Apply infrastructure changes? (DB_MODE=${params.DB_MODE})",
                              ok: 'Apply'
                    }
                }
            }
        }

        stage('Apply infrastructure') {
            when { expression { params.APPLY } }
            steps {
                script {
                    def stacks = params.DB_MODE == 'oracle'
                        ? ['10-db-multipass', '20-wls-k8s', '30-nginx-multipass']
                        : ['20-wls-k8s', '30-nginx-multipass']
                    stacks.each { s ->
                        sh "terraform -chdir=terraform/${s} apply -no-color tfplan"
                    }
                }
            }
        }

        stage('Configure') {
            when { expression { params.APPLY } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'oracle-sys',
                                     usernameVariable: 'ORA_SYS_USER',
                                     passwordVariable: 'ORA_SYS_PASS'),
                    usernamePassword(credentialsId: 'oracle-app',
                                     usernameVariable: 'ORA_APP_USER',
                                     passwordVariable: 'ORA_APP_PASS')
                ]) {
                    // Secrets arrive as env vars and are passed via -e without ever
                    // being written to disk or echoed.
                    script {
                        // Skip the app tag when DEPLOY_APP is false; there is no
                        // shell-side conditional in --skip-tags.
                        def skip = params.DEPLOY_APP ? '' : '--skip-tags app'
                        sh """#!/bin/bash
set -euo pipefail
                            cd ansible
                            ansible-playbook playbooks/site.yml \
                              -e "db_mode=\${DB_MODE}" \
                              -e "app_repo_version=\${APP_BRANCH}" \
                              -e "oracle_sys_password=\${ORA_SYS_PASS}" \
                              -e "oracle_app_user=\${ORA_APP_USER}" \
                              -e "oracle_app_password=\${ORA_APP_PASS}" \
                              ${skip}
                        """
                    }
                }
            }
        }

        stage('Deploy application') {
            when {
                allOf {
                    expression { params.DEPLOY_APP }
                    expression { !params.APPLY }   // Configure already deployed it
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'oracle-app',
                    usernameVariable: 'ORA_APP_USER',
                    passwordVariable: 'ORA_APP_PASS')]) {
                    sh '''#!/bin/bash
set -euo pipefail
                        cd ansible
                        ansible-playbook playbooks/deploy-app.yml \
                          -e "db_mode=${DB_MODE}" \
                          -e "app_repo_version=${APP_BRANCH}" \
                          -e "oracle_app_user=${ORA_APP_USER}" \
                          -e "oracle_app_password=${ORA_APP_PASS}"
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                // Real HTTP assertions: session affinity across the login handover,
                // distribution across servers, and a write-then-read round trip.
                sh '''#!/bin/bash
set -euo pipefail
                    cd ansible
                    ansible-playbook playbooks/site.yml --tags verify -e "db_mode=${DB_MODE}"
                '''
            }
        }
    }

    post {
        success {
            script {
                // This host has no physical LAN (the 192.168.29.x addresses below
                // are the original Linux homelab box's); resolve the real Multipass
                // IPs from Terraform state the same way the "Resolve environment
                // networking overrides" play in ansible/playbooks/site.yml does,
                // falling back to the upstream LAN addresses when that stack's
                // state isn't reachable (e.g. running against the real Linux host).
                def proxyIp = sh(
                    script: '''#!/bin/bash
set -uo pipefail
terraform -chdir=terraform/30-nginx-multipass init -reconfigure -no-color -input=false >/dev/null 2>&1
terraform -chdir=terraform/30-nginx-multipass output -raw proxy_internal_ip 2>/dev/null
''',
                    returnStdout: true
                ).trim()
                if (!proxyIp) { proxyIp = '192.168.29.200' }

                def nodeIp = sh(
                    script: '''#!/bin/bash
set -uo pipefail
terraform -chdir=terraform/05-k8s-multipass init -reconfigure -no-color -input=false >/dev/null 2>&1
terraform -chdir=terraform/05-k8s-multipass output -raw master_ip 2>/dev/null
''',
                    returnStdout: true
                ).trim()
                def ms1Endpoint = nodeIp ? "http://${nodeIp}:30701/customer-onboarding/login" : 'http://192.168.29.201:8090/customer-onboarding/login'
                def ms2Endpoint = nodeIp ? "http://${nodeIp}:30702/customer-onboarding/login" : 'http://192.168.29.202:8090/customer-onboarding/login'

                echo """
================================================================
  Pipeline succeeded

  APPLICATION URL:
    http://${proxyIp}/customer-onboarding/login

  Direct per-JVM endpoints:
    ms1  ${ms1Endpoint}
    ms2  ${ms2Endpoint}

  Database mode: ${params.DB_MODE}
================================================================
"""
            }
        }
        failure {
            echo 'Pipeline failed. Check the Preflight stage first — most failures are platform faults (USB uplink carrier down, k8s node NotReady) rather than code errors.'
        }
        always {
            archiveArtifacts artifacts: 'terraform/*/.generated/*, packer/*/.generated/*',
                             allowEmptyArchive: true,
                             fingerprint: true
        }
    }
}
