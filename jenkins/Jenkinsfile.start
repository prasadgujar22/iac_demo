// ============================================================================
// Start — bring every VM back up after a shutdown.
//
// Counterpart to Jenkinsfile.shutdown: `multipass start` resumes a suspended
// VM in place. Nothing is created or destroyed and Terraform state is
// untouched. Order is the reverse of shutdown -- database and k8s nodes up
// first so the app has something to talk to by the time nginx comes up.
// ============================================================================

pipeline {
    agent { label 'homelab' }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip the confirmation prompt and start immediately.'
        )
    }

    stages {

        stage('Discover VM names') {
            steps {
                script {
                    // Same rationale as Jenkinsfile.shutdown: read names via
                    // `terraform console` against var.* defaults so this
                    // works even when a stack's state is currently empty.
                    sh '''#!/bin/bash
set -euo pipefail
                        for d in terraform/05-k8s-multipass terraform/10-db-multipass terraform/30-nginx-multipass; do
                            terraform -chdir="$d" init -reconfigure -no-color -input=false >/dev/null
                        done
                    '''
                    env.NGINX_VM = sh(
                        script: '''echo 'var.vm_name' | terraform -chdir=terraform/30-nginx-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.DB_VM = sh(
                        script: '''echo 'var.vm_name' | terraform -chdir=terraform/10-db-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.MASTER_VM = sh(
                        script: '''echo 'var.master_name' | terraform -chdir=terraform/05-k8s-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.WORKER_VMS = sh(
                        script: '''echo 'join(" ", var.worker_names)' | terraform -chdir=terraform/05-k8s-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    echo "nginx=${env.NGINX_VM} master=${env.MASTER_VM} workers=${env.WORKER_VMS} db=${env.DB_VM}"
                }
            }
        }

        stage('Confirm') {
            when { expression { !params.AUTO_APPROVE } }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input message: 'Start the database VM, both k8s nodes, and nginx-proxy?',
                          ok: 'Start'
                }
            }
        }

        stage('Start VMs') {
            steps {
                sh '''#!/bin/bash
set -uo pipefail
                    # multipass requires client authentication (local.passphrase is set).
                    # CI runs as a user that is not authenticated, while root bypasses the
                    # check -- so fall back to sudo, same as every provisioner in this repo.
                    mp() { if multipass "$@" 2>/dev/null; then return 0; else sudo -n multipass "$@"; fi; }

                    start_if_stopped() {
                        local name="$1"
                        local state
                        state=$(mp info "$name" --format csv 2>/dev/null | awk -F, 'NR>1{print $2}')
                        if [ -z "$state" ]; then
                            echo "[start] $name: not found, skipping"
                        elif [ "$state" = "Running" ]; then
                            echo "[start] $name: already running"
                        else
                            echo "[start] starting $name"
                            mp start "$name"
                        fi
                    }

                    # Database and k8s first, nginx last -- reverse of the
                    # shutdown order, so the app is reachable by the time the
                    # front door opens.
                    start_if_stopped "$DB_VM"
                    start_if_stopped "$MASTER_VM"
                    for w in $WORKER_VMS; do start_if_stopped "$w"; done
                    start_if_stopped "$NGINX_VM"

                    echo "[start] done:"
                    mp list
                '''
            }
        }
    }

    post {
        success {
            echo "All VMs started. Check readiness with: kubectl get nodes && kubectl get domain wlsdomain -n wls-domain"
        }
    }
}
