// ============================================================================
// Shutdown — stop every VM without destroying anything.
//
// Non-destructive: `multipass stop` suspends the VM. Terraform state and all
// on-disk data (Oracle DB included) are untouched, and nothing is removed
// from state. Bring the stack back with `multipass start <name>` (or just
// re-run homelab-iac, which is safe to re-run against already-created VMs).
// ============================================================================

pipeline {
    agent { label 'homelab' }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip the confirmation prompt and stop immediately.'
        )
    }

    stages {

        stage('Discover VM names') {
            steps {
                script {
                    // Read straight from each stack's `var.*` defaults via
                    // `terraform console` rather than `terraform output`: this
                    // works even when a stack's state is currently empty (e.g.
                    // nginx right after a teardown) or has never been applied
                    // with these output names, so the stage can't hard-fail on
                    // "Output ... not found". Every name is still a real
                    // Terraform value, not a hardcoded guess -- if a stack ever
                    // overrides vm_name via -var, update this too.
                    sh '''#!/bin/bash
set -euo pipefail
                        for d in terraform/05-k8s-multipass terraform/10-db-multipass terraform/30-nginx-multipass; do
                            terraform -chdir="$d" init -reconfigure -no-color -input=false >/dev/null
                        done
                    '''
                    env.NGINX_VM = sh(
                        script: '''echo 'var.vm_name' | terraform -chdir=terraform/30-nginx-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.DB_VM = sh(
                        script: '''echo 'var.vm_name' | terraform -chdir=terraform/10-db-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.MASTER_VM = sh(
                        script: '''echo 'var.master_name' | terraform -chdir=terraform/05-k8s-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    env.WORKER_VMS = sh(
                        script: '''echo 'join(" ", var.worker_names)' | terraform -chdir=terraform/05-k8s-multipass console -no-color | tr -d '"' ''',
                        returnStdout: true
                    ).trim()
                    echo "nginx=${env.NGINX_VM} master=${env.MASTER_VM} workers=${env.WORKER_VMS} db=${env.DB_VM}"
                }
            }
        }

        stage('Confirm') {
            when { expression { !params.AUTO_APPROVE } }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input message: 'Stop nginx-proxy, both k8s nodes, and the database VM? (fully reversible -- multipass start brings them back)',
                          ok: 'Stop'
                }
            }
        }

        stage('Stop VMs') {
            steps {
                sh '''#!/bin/bash
set -uo pipefail
                    # multipass requires client authentication (local.passphrase is set).
                    # CI runs as a user that is not authenticated, while root bypasses the
                    # check -- so fall back to sudo, same as every provisioner in this repo.
                    mp() { if multipass "$@" 2>/dev/null; then return 0; else sudo -n multipass "$@"; fi; }

                    stop_if_running() {
                        local name="$1"
                        local state
                        state=$(mp info "$name" --format csv 2>/dev/null | awk -F, 'NR>1{print $2}')
                        if [ -z "$state" ]; then
                            echo "[shutdown] $name: not found, skipping"
                        elif [ "$state" = "Stopped" ]; then
                            echo "[shutdown] $name: already stopped"
                        else
                            echo "[shutdown] stopping $name"
                            mp stop "$name"
                        fi
                    }

                    # Frontend first, database last: a `stop` is not a graceful
                    # drain either way, this just mirrors the teardown pipeline's
                    # reverse-of-provisioning order for consistency.
                    stop_if_running "$NGINX_VM"
                    for w in $WORKER_VMS; do stop_if_running "$w"; done
                    stop_if_running "$MASTER_VM"
                    stop_if_running "$DB_VM"

                    echo "[shutdown] done:"
                    mp list
                '''
            }
        }
    }

    post {
        success {
            echo "All VMs stopped. Bring the stack back with: multipass start ${env.NGINX_VM} ${env.WORKER_VMS} ${env.MASTER_VM} ${env.DB_VM}"
        }
    }
}
