#cloud-config
# Proxy VM bootstrap. Installs nginx so Ansible has a service to configure;
# all routing/affinity configuration is applied by the nginx_proxy role.
package_update: true
package_upgrade: false

packages:
  - nginx
  - curl

users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_authorized_key}

write_files:
  - path: /etc/sysctl.d/99-proxy.conf
    content: |
      # A reverse proxy opens many short-lived upstream connections.
      net.ipv4.ip_local_port_range = 10240 65535
      net.core.somaxconn = 1024

runcmd:
  # Freeze the DHCP-assigned address as static so it survives VM restarts.
  #
  # Cloud-init's own netplan file (50-cloud-init.yaml) matches the NIC by
  # PermanentMACAddress under a stanza named "default"; systemd-networkd
  # applies only the first matching .network file per link in filename
  # order, and "10-netplan-default.network" sorts before any override
  # keyed "enp0s1", so a plain static override is silently ignored and the
  # interface stays on DHCP. Key our override "00-enp0s1" instead so its
  # generated unit ("10-netplan-00-enp0s1.network") sorts first and
  # actually wins. Learned the hard way on the other VMs in this stack: a
  # 99-*.yaml with a non-conflicting key never took effect, and the IP
  # drifted across restarts anyway.
  - |
    set -e
    IFACE=enp0s1
    for i in $(seq 1 30); do
      IP=$(ip -4 -o addr show "$IFACE" | awk '{print $4}' | cut -d/ -f1)
      [ -n "$IP" ] && break
      sleep 1
    done
    GW=$(ip route show default dev "$IFACE" | awk '{print $3}')
    cat > /etc/netplan/00-static.yaml <<NETPLAN
    network:
      version: 2
      ethernets:
        00-$IFACE:
          match:
            name: $IFACE
          dhcp4: false
          addresses: [$IP/24]
          routes:
            - to: default
              via: $GW
          nameservers:
            addresses: [$GW, 1.1.1.1]
    NETPLAN
    chmod 600 /etc/netplan/00-static.yaml
    netplan apply
  - sysctl --system
  - systemctl enable --now nginx
  - touch /var/lib/cloud/nginx-prereqs-done
