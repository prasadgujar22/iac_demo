#cloud-config
#
# Oracle XE 21c prerequisites. The installer fails in non-obvious ways without
# these, so they are set up before Ansible ever connects.
#
hostname: oracle-db
manage_etc_hosts: true

ssh_authorized_keys:
  - ${ssh_authorized_key}

package_update: true
packages:
  - alien
  - libaio1t64
  - unzip
  - bc
  - net-tools
  - python3

write_files:
  # Oracle's installer checks /etc/hosts for a resolvable hostname; an unresolvable
  # hostname causes the listener to bind to the wrong address.
  - path: /etc/sysctl.d/98-oracle.conf
    content: |
      fs.file-max = 6815744
      kernel.shmmax = 2147483648
      kernel.shmall = 2097152
      net.ipv4.ip_local_port_range = 9000 65500
  - path: /etc/security/limits.d/98-oracle.conf
    content: |
      oracle soft nproc  2047
      oracle hard nproc  16384
      oracle soft nofile 1024
      oracle hard nofile 65536
      oracle soft stack  10240

runcmd:
  # Freeze the DHCP-assigned address as static so it survives VM restarts.
  #
  # Cloud-init's own netplan file (50-cloud-init.yaml) matches the NIC by
  # PermanentMACAddress under a stanza named "default"; systemd-networkd
  # applies only the first matching .network file per link in filename
  # order, and "10-netplan-default.network" sorts before an override keyed
  # "enp0s1", so a plain static override is silently ignored and the
  # interface stays on DHCP. Key our override "00-enp0s1" instead so its
  # generated unit ("10-netplan-00-enp0s1.network") sorts first and
  # actually wins. (Root-caused on the nginx-proxy stack after the earlier
  # manual 99-static.yaml pin on this VM turned out to have never taken
  # effect — same bug.)
  - |
    set -e
    IFACE=enp0s1
    for i in $(seq 1 30); do
      IP=$(ip -4 -o addr show "$IFACE" | awk '{print $4}' | cut -d/ -f1)
      [ -n "$IP" ] && break
      sleep 1
    done
    GW=$(ip route show default dev "$IFACE" | awk '{print $3}')
    cat > /etc/netplan/00-static.yaml <<NETPLAN
    network:
      version: 2
      ethernets:
        00-$IFACE:
          match:
            name: $IFACE
          dhcp4: false
          addresses: [$IP/24]
          routes:
            - to: default
              via: $GW
          nameservers:
            addresses: [$GW, 1.1.1.1]
    NETPLAN
    chmod 600 /etc/netplan/00-static.yaml
    netplan apply

  # XE requires swap; Multipass images ship with none, and the installer aborts.
  - |
    if [ "$(swapon --show --noheadings | wc -l)" -eq 0 ]; then
      fallocate -l 2G /swapfile
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi
  - sysctl --system
  - touch /var/lib/cloud/oracle-prereqs-done
